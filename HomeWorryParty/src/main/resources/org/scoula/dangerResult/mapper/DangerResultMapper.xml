<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.dangerResult.mapper.DangerResultMapper">

    <!-- ResultMap: DangerAnswerVO -->
    <resultMap id="dangerMap" type="org.scoula.dangerResult.domain.DangerAnswerVO">
        <id property="dangerAnswerId" column="answer_id"/>
        <result property="answer" column="answer"/>
        <result property="riskWeight" column="risk_weight"/>
        <result property="effectiveness" column="effectiveness"/>
    </resultMap>


    <!-- ResultMap: DangerResultVO -->
    <resultMap id="dangerResultMap" type="org.scoula.dangerResult.domain.DangerResultVO">
        <id property="grade" column="grade"/>
        <id property="templateId" column="template_id"/>
        <result property="minScore" column="min_score"/>
        <result property="maxScore" column="max_score"/>
        <result property="message" column="message"/>
        <result property="description" column="description"/>
        <result property="imageUrl" column="image_url"/>
    </resultMap>


    <select id="getAnswerList" resultMap="dangerMap">
        select answer_id,
               answer,
               risk_weight,
               effectiveness
        from checklistuseranswer join checklistquestion
                 on checklistuseranswer.question_id = checklistquestion.question_id
        where template_id = #{templateId} and user_id = #{userId};
    </select>

    <select id="getMessageList" resultType="org.scoula.dangerResult.domain.DangerResultVO" resultMap="dangerResultMap">
        select *
        from riskscoremessage
        where template_id = #{templateId};
    </select>


</mapper>