<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.scoula.security.account.mapper.UserDetailsMapper">

    <resultMap id="authMap" type="org.scoula.security.account.domain.AuthVO">
        <result property="userId" column="username"/>
        <result property="auth" column="auth"/>
    </resultMap>

    <resultMap id="userMap" type="org.scoula.security.account.domain.UserVO">
        <id property="userId" column="user_id"/>
        <result property="username" column="name"/>
        <result property="email" column="email"/>
        <result property="password" column="password"/>
        <result property="phone" column="phone"/>
        <result property="userType" column="user_type"/>
        <collection property="authList" ofType="org.scoula.security.account.domain.AuthVO" resultMap="authMap"/>
    </resultMap>

    <select id="getByUserEmail" parameterType="string" resultMap="userMap">
        SELECT u.user_id,
               u.name,
               u.email,
               u.password,
               u.phone,
               u.user_type,
               a.auth,
               a.user_id AS auth_username
        FROM User u
                 LEFT OUTER JOIN user_member_auth a ON u.user_id = a.user_id
        WHERE u.email = #{email}
    </select>

    <select id="getEmailByUsername" resultType="java.lang.String">
        select email
        from User
        where name = #{name}
    </select>
</mapper>
